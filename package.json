{
  "name": "mica",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "MICA — Multinational Index of Consumer Agents",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "export:data": "tsx scripts/export-demo-data.ts",
    "prebuild": "pnpm export:data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "qa:methodology": "playwright test e2e/methodology-hierarchy.spec.ts --forbid-only --project=desktop-chromium --project=tablet-chromium --project=mobile-chromium",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:preview": "MICA_EXPECT_NOINDEX=1 node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "lucide-react": "1.28.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.8",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}

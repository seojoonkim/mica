# Optional canonical deployment URL. Defaults to the current Vercel production alias.
NEXT_PUBLIC_SITE_URL=

# MICA — optional remote data source.
# Leave BOTH Supabase values empty to run entirely on local demo fixtures.
# A secret-free build must succeed with this file copied to .env.local unchanged.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
